---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../lib/config';
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const indexable = site.public && !noindex;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': site.url + '/#website',
      url: site.url,
      name: 'Maison Lucas Banega',
      alternateName: 'Lucas Banega',
      inLanguage: 'es',
      publisher: { '@id': site.url + '/#organization' },
    },
    {
      '@type': 'Organization',
      '@id': site.url + '/#organization',
      name: 'Maison Lucas Banega',
      alternateName: 'Lucas Banega',
      description:
        'Marroquinería de cuero. Primer objeto en desarrollo: un tarjetero.',
      url: site.url,
      logo: site.url + '/logo-banega.png',
    },
  ],
};
---

<!doctype html>
<html lang="es" class:list={{ 'campaign-home': Astro.url.pathname === '/' }}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#FFFFFF" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={indexable ? 'index, follow' : 'noindex, nofollow'}
    />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    {/* Adobe Fonts sin bloquear la primera pintura: se aplica al cargar. */}
    <link
      rel="preload"
      href="https://use.typekit.net/jme3jsg.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="https://use.typekit.net/jme3jsg.css" />
    </noscript>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Maison Lucas Banega" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site.url + '/images/social.jpg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Lucas Banega: imágenes conceptuales de campaña."
    />
    <meta name="twitter:card" content="summary_large_image" />
    {site.public && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, '\u003c')}
      ></script>
    )}
  </head>
  <body class:list={{ 'campaign-home': Astro.url.pathname === '/' }}>
    <SiteHeader />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <SiteFooter showLaunch={Astro.url.pathname !== '/'} />
  </body>
</html>
