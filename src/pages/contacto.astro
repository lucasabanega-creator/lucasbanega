---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/config';
---

<Layout
  title="Contacto | Lucas Banega"
  description="El canal de consultas de Lucas Banega estará disponible próximamente."
  noindex={!site.contact}
>
  <section class="page-heading wrap contact-heading">
    <p class="eyebrow">CONTACTO</p>
    <h1>El comienzo de una conversación.</h1>
    {site.contact ? (
      <>
        <p>Para consultas sobre Lucas Banega, escribinos.</p>
        <a class="contact-email" href={'mailto:' + site.contact}>
          {site.contact}
        </a>
      </>
    ) : (
      <>
        <p>Estamos preparando nuestro canal de contacto.</p>
        <p class="small">
          El correo oficial se incorporará antes del lanzamiento. Por ahora no
          recibimos consultas a través de esta web.
        </p>
      </>
    )}
    <a class="text-link" href="/primer-objeto">
      Conocé nuestro primer proyecto
    </a>
  </section>
</Layout>
