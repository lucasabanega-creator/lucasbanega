---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/config';
type Section = { title: string; body: string };
---

<Layout
  title="Privacidad | Lucas Banega"
  description="Información sobre la privacidad y el estado de la recepción de datos en Lucas Banega."
  noindex={!site.live}
>
  <section class="page-heading wrap legal">
    <p class="eyebrow">INFORMACIÓN</p>
    <h1>Privacidad</h1>
    {site.live ? (
      <>
        <p>Responsable: {site.privacy.controller}</p>
        <p class="small">Actualización: {site.privacy.updated}</p>
        {(site.privacy.sections as Section[]).map((section) => (
          <section>
            <h2>{section.title}</h2>
            <p>{section.body}</p>
          </section>
        ))}
      </>
    ) : (
      <>
        <h2>Inscripciones aún cerradas.</h2>
        <p>
          Los campos de suscripción están deshabilitados y no se reciben
          direcciones de correo a través del formulario de novedades.
        </p>
        <p>
          No incorporamos herramientas publicitarias ni scripts de analítica. El
          alojamiento puede generar registros técnicos para entregar y proteger
          el sitio.
        </p>
        <p>
          Antes de abrir las inscripciones publicaremos la información sobre el
          responsable, el proveedor de correo, la finalidad, los plazos de
          conservación y el ejercicio de derechos.
        </p>
        <p class="small">Este aviso describe el estado actual del sitio.</p>
      </>
    )}
    <a class="text-link" href="/">
      Volver al inicio
    </a>
  </section>
</Layout>
