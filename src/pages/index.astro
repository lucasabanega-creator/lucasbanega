---
import Layout from '../layouts/Layout.astro';
import EditorialHero from '../components/EditorialHero.astro';
import { es } from '../content/es';
---

<Layout {...es.home}>
  <EditorialHero />

  <section
    id="materia"
    class="campaign-stories editorial-chapter"
    aria-label="Explorar Lucas Banega"
  >
    <a class="story" href="/maison">
      <div class="story-image">
        <img
          src="/images/material-v2.webp"
          width="1122"
          height="1402"
          alt="Cuero taupe y tejido claro bajo luz natural."
          loading="lazy"
        />
      </div>
      <h2>La belleza de la materia</h2>
      <span>Explorar la maison</span>
    </a>
    <a class="story" href="/primer-objeto">
      <div class="story-image story-object">
        <img
          src="/images/cardholder-concept.webp"
          width="1086"
          height="1448"
          alt="Imagen conceptual de un tarjetero de cuero marfil con la firma Lucas Banega."
          loading="lazy"
        />
      </div>
      <h2>El primer objeto</h2>
      <span>Tarjetero en desarrollo</span>
    </a>
  </section>

  <section
    class="campaign-feature editorial-chapter"
    aria-labelledby="feature-title"
  >
    <div class="campaign-feature-visual">
      <img
        src="/images/cardholder-editorial.webp"
        width="1536"
        height="1024"
        alt="Imagen conceptual del tarjetero Lucas Banega sobre una superficie de piedra clara."
        loading="lazy"
      />
    </div>
    <div class="campaign-feature-copy">
      <p class="eyebrow">EL PRIMER OBJETO</p>
      <h2 id="feature-title">Una forma esencial.</h2>
      <p>
        Una propuesta de pequeño formato. El tarjetero está en desarrollo;
        proporciones, cuero y terminaciones se definirán con las primeras
        muestras.
      </p>
      <a class="quiet-link" href="/primer-objeto">
        Conocer el primer objeto
      </a>
    </div>
  </section>

  <section
    class="campaign-statement editorial-chapter"
    aria-labelledby="statement-title"
  >
    <p class="eyebrow">Lucas Banega</p>
    <h2 id="statement-title">Objetos para acompañar.</h2>
    <p>
      Diseño, materia y atención al uso.
      <br />
      Nuestro primer tarjetero está en desarrollo.
    </p>
    <a class="quiet-link" href="/maison">
      Descubrir la maison
    </a>
  </section>
</Layout>
