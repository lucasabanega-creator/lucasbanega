---
import Wordmark from './Wordmark.astro';
import MobileNavigation from './MobileNavigation.astro';
const currentPath = Astro.url.pathname;
---

<a class="skip-link" href="#contenido">
  Saltar al contenido
</a>
<header class="site-header">
  <div class="brand-row">
    <div class="header-service">
      <MobileNavigation />
      <a class="desktop-service" href="/contacto">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.1"
          aria-hidden="true"
        >
          <path d="M7 3h3l1.3 4.2-1.7 1.7a15 15 0 0 0 5.5 5.5l1.7-1.7L21 14v3a3 3 0 0 1-3.2 3A17 17 0 0 1 4 6.2 3 3 0 0 1 7 3Z" />
        </svg>
        Contacto
      </a>
    </div>
    <div class="brand-signature">
      <Wordmark />
    </div>
    <a class="header-news" href="/#novedades" aria-label="Novedades">
      <svg
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.2"
        aria-hidden="true"
      >
        <rect x="3" y="5" width="18" height="14" rx="0.5" />
        <path d="m3 6 9 7 9-7" />
      </svg>
      <span>Novedades</span>
    </a>
  </div>
  <nav class="collection-nav" aria-label="Navegación principal">
    <a
      href="/maison"
      aria-current={currentPath === '/maison' ? 'page' : undefined}
    >
      La maison
    </a>
    <a
      href="/primer-objeto"
      aria-current={currentPath === '/primer-objeto' ? 'page' : undefined}
    >
      Primer objeto
    </a>
    <a href="/#materia">Materia y gesto</a>
    <a href="/#novedades">Novedades</a>
  </nav>
</header>
<noscript>
  <nav class="nojs-nav" aria-label="Navegación sin JavaScript">
    <a
      href="/maison"
      aria-current={currentPath === '/maison' ? 'page' : undefined}
    >
      Maison
    </a>
    <a
      href="/primer-objeto"
      aria-current={currentPath === '/primer-objeto' ? 'page' : undefined}
    >
      Primer objeto
    </a>
    <a href="/contacto">Contacto</a>
  </nav>
</noscript>
<script>
  const homeHeader = document.querySelector<HTMLElement>(
    '.campaign-home .site-header',
  );
  if (homeHeader) {
    let ticking = false;
    const updateHeader = () => {
      homeHeader.classList.toggle('is-condensed', window.scrollY > 32);
      ticking = false;
    };
    updateHeader();
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateHeader);
      },
      { passive: true },
    );
    window.addEventListener('pageshow', updateHeader);
  }
</script>
