---
interface Props {
  variant?: 'hero' | 'detail';
  priority?: boolean;
  caption?: boolean;
}
const { variant = 'hero', priority = false, caption = true } = Astro.props;
---

<figure class:list={['material-image', variant]}>
  <picture>
    <img
      src="/images/material-v2.webp"
      alt="Estudio conceptual de cuero y algodón bajo luz natural."
      width="1122"
      height="1402"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </picture>
  {caption && <figcaption>Imágenes conceptuales de campaña.</figcaption>}
</figure>
