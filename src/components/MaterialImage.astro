---
interface Props {
  variant?: 'hero' | 'detail';
  priority?: boolean;
  caption?: boolean;
}
const { variant = 'hero', priority = false, caption = true } = Astro.props;
---

<figure class:list={['material-image', variant]}>
  <picture>
    <img
      src="/images/material-v2-840.webp"
      srcset="
        /images/material-v2-560.webp   560w,
        /images/material-v2-840.webp   840w,
        /images/material-v2.webp      1122w
      "
      sizes="(max-width:599px) calc(100vw - 40px), (max-width:1240px) 45vw, 560px"
      alt="Estudio conceptual de cuero y algodón bajo luz natural."
      width="1122"
      height="1402"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </picture>
  {caption && <figcaption>Imágenes conceptuales de campaña.</figcaption>}
</figure>
