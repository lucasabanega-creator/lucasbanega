---
import Layout from '../layouts/Layout.astro';
import EditorialHero from '../components/EditorialHero.astro';
import MaterialSection from '../components/MaterialSection.astro';
import LaunchForm from '../components/LaunchForm.astro';
import { es } from '../content/es';
---

<Layout {...es.home}>
  <EditorialHero />
  <section class="idea-section wrap">
    <p class="eyebrow">UNA FORMA DE MIRAR</p>
    <div>
      <h2>{es.idea.title}</h2>
      <p>{es.idea.text}</p>
      <a class="text-link" href="/maison">
        La visión de la maison <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <MaterialSection />
  <section class="first-section wrap">
    <div class="first-heading">
      <p class="eyebrow">02 / PRIMER OBJETO</p>
      <p class="small development">
        <span aria-hidden="true"></span> En desarrollo
      </p>
    </div>
    <div class="first-grid">
      <h2>{es.first.title}</h2>
      <div>
        <p>{es.first.text}</p>
        <a class="text-link" href="/primer-objeto">
          Conocer el proyecto <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="object-type" aria-hidden="true">
      <span>Weekender</span>
      <span class="object-caption">EL PUNTO DE PARTIDA</span>
    </div>
  </section>
  <LaunchForm />
</Layout>
